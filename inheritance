		String name="anu";
		int age=20;
		System.out.println("Student name: "+name+"\nStudent age: "+age);
	}

}
class Students extends College{
	
	void infor() {
		int rollno=9875766;
		int mark=90;
		System.out.println("Student roll no: "+rollno+"\nStudent mark: "+mark);
	}
	
