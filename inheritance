//1.zoo management
class Animal{
	void eat() {
		System.out.println("it eats");
	}
}
class Dog extends Animal{
     
	void sound() {
		System.out.println("it barks");
	}
}
public class Demo {
	public static void main(String[] args) {
		
		Dog d=new Dog();
		d.eat();
		d.sound();
		
	}
}


//2.Vehicle
class Vehicle{
	void features() {
		System.out.println("has engine and brake");
	}
}
class Car extends Vehicle{
     
	void behaviour() {
		System.out.println("it drives");
	}
}
public class Demo {
	public static void main(String[] args) {
		
		Car c=new Car();
		c.features();
		c.behaviour();
		
	}
}



//3.College database
