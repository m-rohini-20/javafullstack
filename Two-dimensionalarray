//		  symmetric matrix
			System.out.print("Enter row size: ");
			int R=scan.nextInt();
			System.out.print("Enter column size: ");
			int C=scan.nextInt();
			int A[][]=new int[R][C];
			int B[][]=new int[R][C];
			System.out.println("Enter elements of :");
			for(int i=0;i<R;i++) {
				for(int j=0;j<C;j++) {
					A[i][j]=scan.nextInt();
				}
			}
			
			System.out.println("Elements of matrix:");
			for(int i=0;i<R;i++) {
				for(int j=0;j<C;j++) {
					System.out.print(A[i][j]+" ");
				}
				System.out.println();
			}
			System.out.println("Transpose : ");
			for(int i=0;i<R;i++) {
				for(int j=0;j<C;j++) {
					B[i][j]=A[j][i];
					System.out.print(B[i][j]+" ");
				}
				System.out.println();
				
			}
			int Ct=0; 
			for(int i=0;i<R;i++) {
				for(int j=0;j<C;j++) {
					if(A[i][j]!=B[i][j]) {
						Ct++;
					}
				}
			}
			if(Ct==0) {
				System.out.println("Symmetric matrix");
			}
			else {
				System.out.println("Not a symmetric matrix");
			}
		
		
		
