public class StringTask {

	 public boolean check(String P){
		 int uc=0,lc=0,dt=0,sp=0;
		 boolean flag=true;
		 if(P.length()==8) {
			 
			 for(int i=0;i<P.length();i++) {
				 char C=P.charAt(i);
				 if(C>='A' && C<='Z') {
					 uc++;
				 }
				 else if(C>='a' && C<='z') {
					 lc++;
				 }
				 else if(C>='0' && C<='9') {
					 dt++;
				 }
				 else {
					 sp++;
				 }
			 }
			
			  if(uc>=1 && lc>=1 && dt>=1 && sp>=1) {
				  System.out.println("Valid Password");
				  flag=false;
				  
			  }
			  else {
				  System.out.println("Invalid Password(must contains atleast one uppercase,one lowercase,one digit and a special character");
			  }
		 }
		 else {
			 System.out.println("Password length must be 8 characters");
			 
		 }
	    return flag;
			
		}
	

