//7.bank application
class Bank{

	 int bal=5000;
	 void show(long no,String name) {
		 System.out.println("Account  number: "+no+"\nName: "+name+"\nBalance: "+bal);
		 
	 }
	 void deposit(double amt) {
		 System.out.println("Your current balance: "+(bal+amt));
	 }
	 void withdraw(double amt) {
		 if(amt<bal)
		 System.out.println("Available balance: "+(bal-amt));
		 else
			 System.out.println("Insufficient balance");
	 }
	
	
	
 }

public class Demo {

	public static void main(String[] args) {
		Scanner x=new Scanner(System.in);
		System.out.println("enter account number, name: ");
		long an=x.nextLong();
		x.nextLine();
		String name=x.nextLine();
		Bank b=new Bank();
		b.show(an, name);
		System.out.println("enter choice(1-deposit ,2-withdraw):");
		int ch=x.nextInt();
		if(ch==1) {
			System.out.print("Enter deposit amt: ");
			double amt=x.nextDouble();
			b.deposit(amt);
			
		}
		else if(ch==2) {
			System.out.println("Enter withdraw amt: ");
			double amt=x.nextDouble();
			b.withdraw(amt);
		}
		else {
			System.out.println("invalid choice ");
		}
		
	}
}

