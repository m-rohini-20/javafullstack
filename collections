package oops;
import java.util.*;
public class Collections {

	public static void main(String[] args) {
	
		Scanner sc=new Scanner(System.in);
		ArrayList<Object> ar=new ArrayList<>();
		while(true) {
			
			System.out.println("add item/remove item/view cart/exit");
			String choice=sc.nextLine();
			
			if(choice.equalsIgnoreCase("add item")) {
				System.out.println("enter item");
				while(true) {
					String item=sc.nextLine();
					if(item.equalsIgnoreCase("exit")) {
						break;
					}
					else {
						ar.add(item);
					}
					
				}
				
			}
			
			else if(choice.equalsIgnoreCase("remove item")) {
				System.out.println("Enter item");
				while(true) {
					String item=sc.nextLine();
					if(item.equalsIgnoreCase("exit")) {
						break;
					}
					else {
						if(ar.contains(item)) {
							int index=ar.indexOf(item);
							ar.remove(index);
							System.out.println("item removed");
						}
						else {
							System.out.println("item not found");
						}
					}
				}
				
			}
			
			else if(choice.equalsIgnoreCase("view cart")) {
				System.out.println(ar);
			}
			
			else if(choice.equalsIgnoreCase("exit")) {
				
				System.out.println("cart exit");
				break;
			}
			
			else {
				System.out.println("Invalid option! try again");
			}
		}




		//task-2
	ArrayList<Integer> arr=new ArrayList<>();
	System.out.print("Enter no of students: ");
	int n=sc.nextInt();
	System.out.println("Enter students mark:");
	for(int i=0;i<n;i++) {
		arr.add(sc.nextInt());
	}
	System.out.println("Students mark list: ");
	Iterator <Integer>i=arr.iterator();
	while(i.hasNext()) {
		System.out.println(i.next());
	}
	System.out.println("enter the position and mark of the student to update: ");
	int index=sc.nextInt();
	int mark=sc.nextInt();
	if(index>=0 && index<=arr.size()) {
	arr.set((index-1), mark);
	}
	else {
		System.out.println("Invalid index");
	}
	System.out.println("Updated Students mark list: ");
	Iterator <Integer>jj=arr.iterator();
	while(jj.hasNext()) {
		System.out.println(jj.next());
	}
	System.out.print("Average mark of the students: ");
	int sum=0;
	for(int j:arr) {
		sum+=j;		
	}
	System.out.println(sum);
	}

}
